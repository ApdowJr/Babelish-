{
  "expo": {
    "name": "Babelish",
    "slug": "babelish",
    "version": "3.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "babelish",
      "zelvoca"
    ],
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.zelvoca.babelish",
      "buildNumber": "3.4.1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Babelish uses your microphone so you can practise speaking with your AI tutor.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.zelvoca.babelish",
      "versionCode": 30401,
      "adaptiveIcon": {
        "backgroundColor": "#3125B5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Babelish uses your microphone so you can practice speaking with your AI tutor.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 168,
          "resizeMode": "contain",
          "backgroundColor": "#0B3A2C",
          "dark": {
            "backgroundColor": "#0B3A2C",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F4C3A",
          "defaultChannel": "daily-reminder"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "e7eb2646-bd1a-476f-a54e-3941e6e18066"
      }
    }
  }
}
