# Expo SDK 58 pins react@19.3.0 while transitive deps pull react-dom@19.3.1
# (peer react@^19.3.1). npm's strict peer resolution fails on that mismatch;
# the lockfile has always been generated with legacy resolution, so every
# install — local and on Vercel — must use it too. See PHASE1.md "installing".
legacy-peer-deps=true
