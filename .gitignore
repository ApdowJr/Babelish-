# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo (native-only: Android + iOS, no web)
.expo/
dist/
expo-env.d.ts

# Native build outputs — never commit binaries, download them from
# GitHub Actions ("Build mobile (APK + iOS)") or EAS instead
*.apk
*.aab
*.ipa
*.app
build-output/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders (created by `expo prebuild`, never edited by hand)
/ios
/android

# local environment
.env
.env.*
!.env.example
.neon

# Store signing credentials — never commit (Play service account, keystores)
secrets/
*.keystore
*.jks
