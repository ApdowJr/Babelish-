# ── Neon backend (real accounts, cloud progress sync, app API) ──────────────
# The production endpoints are compiled in as PUBLIC defaults (src/lib/neon.ts
# — they are plain service URLs, no keys), so every build — Vercel previews,
# EAS binaries, fresh clones — talks to the real backend without any env vars.
# The values below OVERRIDE the defaults (staging branches, forks, self-host).
# EXPO_PUBLIC_NEON_AUTH_BASE_URL=https://<branch>-auth.<region>.aws.neon.tech/...
# EXPO_PUBLIC_NEON_FUNCTION_API_URL=https://<branch>-api.compute.<region>.aws.neon.tech
# EXPO_PUBLIC_NEON_ORIGIN=https://zelvoca.app   # trusted domain on the branch
# Set to 1 to force on-device demo mode on purpose (offline dev, empty-state
# screenshots): accounts stay local and the home screen shows the demo banner.
# EXPO_PUBLIC_NEON_DISABLED=1

# ── App build overrides (public, compiled into the bundle) ──────────────────
# Optional. Point the app at a different tutor gateway than the default backend
# (staging, a fork, a self-hosted Function). Public URL only — never a key.
# EXPO_PUBLIC_AI_GATEWAY_URL=https://your-gateway.example.org

# ── Tutor server (Neon Function env) ───────────────────────────────────────
# The app never holds a model key: it calls POST /api/ai/chat on the Function,
# which forwards to whatever OpenAI-compatible endpoint you configure here.
# Setting any of these turns the tutor on for every learner — no app rebuild,
# no model screen, nothing for the learner to install.
#
# Recommended: OpenRouter's free Qwen3 endpoints (119 languages, all 24 of ours).
# Sign up at https://openrouter.ai/keys and put the key ONLY here (never in an
# EXPO_PUBLIC_* variable).
# AI_API_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-...
# AI_MODELS=qwen/qwen3-next-80b-a3b-instruct:free,qwen/qwen3-next-80b-a3b-instruct
#   ↑ comma-separated fallback chain; free endpoints rotate, so the server
#     tries each in order and only moves on when a model has disappeared.
# AI_STT_MODEL=openai/whisper-large-v3-turbo   # metered per second of audio
# AI_STT_ENABLED=false                        # set false to keep voice on-device
#
# Daily budget. Free model endpoints are not infinite: an unfunded OpenRouter
# account allows roughly 50 requests/day (1,000/day after a one-time $10 credit).
# The server keeps a per-learner cap and a server-wide cap, both resetting at
# 00:00 UTC; when either is reached the learner sees a dated message ("resumes
# at 02:00") and the rest of the app keeps working. Raise these after buying
# credit — the code never assumes more than you configure.
# AI_DAILY_CHAT=30          # tutor messages per signed-in learner per UTC day
# AI_DAILY_STT=12           # voice transcriptions per signed-in learner per day
# AI_DAILY_GUEST_CHAT=6     # same, for anonymous visitors (per IP)
# AI_DAILY_GUEST_STT=2
# AI_DAILY_BUDGET=45        # all chat calls across all learners per day
#   ↑ keep this at or below your provider's real daily allowance.
#
# Self-hosted alternative (no account, no bill):
# AI_API_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5:1.5b
# AI_STT_MODEL=whisper-large-v3-turbo
#
# Unset = tutor reports 503 ai-not-configured and the app runs its coach. That
# is the normal open-source default; nothing silently calls a paid provider.
# Ops admin used by DELETE /api/me to erase the auth user itself after wiping
# the account's rows. Create the user via the app sign-up, then promote it:
#   UPDATE neon_auth."user" SET role='admin' WHERE email='<ops-email>';
# When unset (demo mode), the auth-user step is skipped and reported as
# "not-configured" — honest, not silent.
# NEON_AUTH_ADMIN_EMAIL=ops-admin@zelvoca.app
# NEON_AUTH_ADMIN_PASSWORD=rotate-me

# ── Supabase (legacy accounts & progress storage) ───────────────────────────
# Create a free project at https://supabase.com → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
