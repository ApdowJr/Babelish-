# ── Neon backend (real accounts, cloud progress sync, app API) ──────────────
# The production endpoints are compiled in as PUBLIC defaults (src/lib/neon.ts
# — they are plain service URLs, no keys), so every build — Vercel previews,
# EAS binaries, fresh clones — talks to the real backend without any env vars.
# The values below OVERRIDE the defaults (staging branches, forks, self-host).
# EXPO_PUBLIC_NEON_AUTH_BASE_URL=https://<branch>-auth.<region>.aws.neon.tech/...
# EXPO_PUBLIC_NEON_FUNCTION_API_URL=https://<branch>-api.compute.<region>.aws.neon.tech
# EXPO_PUBLIC_NEON_ORIGIN=https://zelvoca.app   # trusted domain on the branch
# Set to 1 to force on-device demo mode on purpose (offline dev, empty-state
# screenshots): accounts stay local and the home screen shows the demo banner.
# EXPO_PUBLIC_NEON_DISABLED=1

# ── AI: client-side model endpoints (all optional, no paid API required) ────
# Babelish talks to open-weight models through adapters. Every value here ends
# up in the public bundle, so it must be an address a browser may call — never
# a credential. A local Ollama / llama.cpp / LM Studio server needs no key.
#
# Default at runtime (no env needed): http://localhost:11434 + qwen2.5:1.5b.
# Change them in the app under Settings → AI model; these env vars only seed a
# fresh install (useful for a shared classroom machine or a LAN server).
# EXPO_PUBLIC_OLLAMA_URL=http://192.168.1.20:11434
# EXPO_PUBLIC_OLLAMA_MODEL=qwen2.5:1.5b
# Preselect a mode: auto | local | server | browser | offline
# EXPO_PUBLIC_TUTOR_MODE=auto

# ── Neon Function env (server-side, set via `neon functions deploy --env`) ──
# OPTIONAL self-hosted inference gateway. Set AI_API_URL to an OpenAI-compatible
# endpoint YOU host (Ollama / llama.cpp / LM Studio / vLLM / faster-whisper).
# Leaving all three unset is the normal open-source deployment: the Function
# answers 503 ai-not-configured and the app uses local, browser or offline
# paths. A paid provider is possible but never implied — if you point this at
# one, you pay for it.
# AI_API_URL=http://127.0.0.1:11434/v1   # default when enabled
# AI_API_KEY=                            # only if your server needs one
# AI_MODEL=qwen2.5:1.5b                  # any model id your server serves
# AI_STT_MODEL=whisper-large-v3-turbo    # needs /audio/transcriptions
# AI_STT_ENABLED=false                   # chat-only servers: turn STT off
# Ops admin used by DELETE /api/me to erase the auth user itself after wiping
# the account's rows. Create the user via the app sign-up, then promote it:
#   UPDATE neon_auth."user" SET role='admin' WHERE email='<ops-email>';
# When unset (demo mode), the auth-user step is skipped and reported as
# "not-configured" — honest, not silent.
# NEON_AUTH_ADMIN_EMAIL=ops-admin@zelvoca.app
# NEON_AUTH_ADMIN_PASSWORD=rotate-me

# ── Supabase (legacy accounts & progress storage) ───────────────────────────
# Create a free project at https://supabase.com → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
